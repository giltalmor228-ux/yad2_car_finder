{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Framework Specification Companion Data",
  "type": "object",
  "required": ["project", "risk_classes", "roles", "states", "gates", "artifacts"],
  "properties": {
    "project": {"type": "string"},
    "risk_classes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "triggers", "path"],
        "properties": {
          "name": {"type": "string"},
          "triggers": {"type": "array", "items": {"type": "string"}},
          "path": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "decision", "output"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
          "decision": {"type": "string"},
          "output": {"type": "string"}
        }
      }
    },
    "states": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "producer", "consumers"],
        "properties": {
          "name": {"type": "string"},
          "producer": {"type": "string"},
          "consumers": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
