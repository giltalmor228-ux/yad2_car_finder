# Notification channels: telegram (default), email, or both.
# Override per run: --notify telegram | --notify email | --notify both
NOTIFY_CHANNELS=telegram

# Telegram Bot credentials (required when telegram channel is enabled + --send)
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Email / SMTP (required when email channel is enabled + --send)
# Gmail: use an App Password; SMTP_HOST=smtp.gmail.com SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_TO=
# Optional: SMTP_USE_SSL=true for port 465; SMTP_STARTTLS=false to disable STARTTLS
# SMTP_USE_SSL=
# SMTP_STARTTLS=

# Set to "true" to enable saving raw HTML snapshots for debugging
DEBUG_SNAPSHOTS=false

# Directory for debug HTML snapshots (relative to project root)
SNAPSHOT_DIR=debug_snapshots

# Optional: full path to the Node.js executable used by --browser mode
# (only needed if `node` is not already on PATH)
NODE_EXECUTABLE=node

# Optional: installed browser channel used by --browser mode (Playwright JS)
PLAYWRIGHT_BROWSER_CHANNEL=chrome

# Optional: attach to an already-open Chrome instead of launching a new window.
# Chrome must have been started with --remote-debugging-port=9222
# PLAYWRIGHT_CDP_URL=http://127.0.0.1:9222
# PLAYWRIGHT_REUSE_TAB=true
